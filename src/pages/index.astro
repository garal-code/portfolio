---
import Layout from "../layouts/Layout.astro";
import BonsaiVideo from "../components/bonsai/BonsaiVideo.astro";
import { careerOrder } from "../lib/bonsai/career.ts";
import { CHAPTERS, type ChapterId } from "../lib/bonsai/chapters.ts";
import {
  education,
  interests,
  jobs,
  personalInfo,
  project,
  skills,
} from "../data/resume.ts";

// One section per chapter, in the approved S3 order. Section height follows the
// chapter scrollWeight; the scroll-scrubbed video (S9) is fixed behind.
const weight = (id: ChapterId) =>
  CHAPTERS.find((chapter) => chapter.id === id)!.scrollWeight;
const sectionStyle = (id: ChapterId) =>
  `--chapter-height: calc(${weight(id)} * 100svh);`;

const years = (start: string, end?: string) => `${start}–${end ?? "hoy"}`;
// resume.ts lists jobs newest first; the branches grow oldest first, the same
// order the generator uses.
const careerJobs = careerOrder(jobs);
const careerSlice = weight("branches") / careerJobs.length;

// Below md the card is compact and sits at the bottom of the viewport (the copy
// safe zone, ~45%), so the video stays visible above it. A max-height with
// internal scroll keeps it from growing over the scene when its content grows
// later (S7). From md up it is the 40% left column, vertically centred.
//
// Cards scroll like a page (S13): each one is sticky inside its own section (or
// career stop), held at the bottom on mobile and at the centre from md while its
// chapter lasts, then carried away by the page as the next one comes in. No
// fades and no script: see `[data-chapter-card]` in the style below.
//
// The sections keep their scroll heights: the background player measures them.
// On mobile the first one is one screen taller (`firstExtra`), as it has been
// since the cards were pinned to the bottom edge; changing it would move the
// video anchors.
const sectionClass =
  "relative z-10 flex min-h-[var(--chapter-height)] items-end px-4 py-3 md:items-start md:px-16 md:py-10";
const firstExtra = "max-md:min-h-[calc(var(--chapter-height)+100svh)]";
// The cards float over the video as soft bubbles (`.bubble-card` below): large
// radius, a light rim, an inner highlight and layered shadows. The fill is the
// solid palette cream, so text keeps AA contrast over any frame.
const panelClass =
  "bubble-card max-h-[42svh] w-full overflow-y-auto bg-cream p-4 md:max-h-[80svh] md:max-w-[40%] md:p-6";
const titleClass =
  "font-display text-2xl font-extrabold tracking-tight text-forest md:text-4xl";
const contactIconClass =
  "bubble-chip grid size-11 place-items-center rounded-full bg-sand text-forest md:size-12";
const appButtonClass =
  "bubble-button flex h-11 items-center rounded-full bg-forest px-4 text-sm font-bold text-cream md:h-12 md:px-5";
const bodyClass =
  "mt-2 text-sm leading-relaxed text-body md:mt-3 md:text-base";
const chipListClass =
  "mt-3 flex flex-wrap gap-1.5 text-xs text-forest md:mt-4 md:gap-2 md:text-sm";
const chipClass = "bubble-chip rounded-full bg-sand px-2.5 py-0.5 md:px-3 md:py-1";
---

<Layout>
  <BonsaiVideo />

  <!-- Contact, fixed at the top right for the whole scroll. -->
  <nav aria-label="Contacto" data-contact-bar>
    <ul class="flex items-center gap-2 md:gap-3">
      <li>
        <a href={personalInfo.links.linkedin} rel="noopener" aria-label="LinkedIn" title="LinkedIn" class={contactIconClass}>
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
          </svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${personalInfo.email}`} aria-label="Email" title={personalInfo.email} class={contactIconClass}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
      </li>
      <li>
        <a href={personalInfo.links.github} rel="noopener" aria-label="GitHub" title="GitHub" class={contactIconClass}>
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8" />
          </svg>
        </a>
      </li>
      <li>
        <a href={project.url} rel="noopener" class={appButtonClass}>{project.name}</a>
      </li>
    </ul>
  </nav>

  <section
    id="seed"
    data-chapter="seed"
    class={`${sectionClass} ${firstExtra}`}
    style={sectionStyle("seed")}
    aria-labelledby="seed-title"
  >
    <div class={panelClass} data-chapter-card>
      <h1
        id="seed-title"
        class="mt-2 font-display text-3xl font-extrabold leading-[0.95] tracking-tight text-forest md:mt-3 md:text-5xl"
      >
        {personalInfo.name}
      </h1>
      <p class={bodyClass}>{personalInfo.bio}</p>
      <ul class={chipListClass}>
        {
          interests.map((interest) => (
            <li class={chipClass}>
              {interest.title} · {interest.note}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="sprout"
    data-chapter="sprout"
    class={sectionClass}
    style={sectionStyle("sprout")}
    aria-labelledby="sprout-title"
  >
    <div class={panelClass} data-chapter-card>
      <h2 id="sprout-title" class={titleClass}>Dónde empezó</h2>
      <ul class="mt-3 space-y-2 text-sm text-body md:mt-4 md:space-y-3 md:text-base">
        {
          education.map((item) => (
            <li>
              <p class="font-semibold text-ink">{item.degree}</p>
              <p class="text-sm text-meta">
                {item.institution} · {years(item.startYear, item.endYear)}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="trunk"
    data-chapter="trunk"
    class={sectionClass}
    style={sectionStyle("trunk")}
    aria-labelledby="trunk-title"
  >
    <div class={panelClass} data-chapter-card>
      <h2 id="trunk-title" class={titleClass}>Los fundamentos</h2>
      <p class={bodyClass}>{personalInfo.summary}</p>
      <ul class={chipListClass}>
        {skills.map((skill) => <li class={chipClass}>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section
    id="branches"
    data-chapter="branches"
    class="relative z-10 min-h-[var(--chapter-height)] px-4 md:px-16"
    style={sectionStyle("branches")}
    aria-labelledby="branches-title"
  >
    <ol class="m-0 list-none p-0">
      {
        careerJobs.map((job, index) => (
          <li
            data-branch-stop={index}
            class="flex items-end py-3 md:items-start md:py-10"
            style={`min-height: calc(${careerSlice} * 100svh);`}
          >
            <article class={panelClass} data-chapter-card>
              {index === 0 && (
                <>
                  <h2 id="branches-title" class={titleClass}>La carrera</h2>
                </>
              )}
              <p class="mt-3 font-display text-xl font-bold text-forest md:mt-4 md:text-2xl">
                {job.company}
              </p>
              <p class="text-sm text-meta">
                {job.role} · {years(job.startDate, job.endDate)}
              </p>
              <p class={bodyClass}>{job.summary}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="pruning"
    data-chapter="pruning"
    class={sectionClass}
    style={sectionStyle("pruning")}
    aria-labelledby="pruning-title"
  >
    <div class={panelClass} data-chapter-card>
      <h2 id="pruning-title" class={titleClass}>Cómo trabaja</h2>
      <ul class="mt-3 space-y-2 text-sm text-body md:mt-4 md:text-base">
        {personalInfo.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </section>

  <section
    id="pagoda"
    data-chapter="pagoda"
    class={sectionClass}
    style={sectionStyle("pagoda")}
    aria-labelledby="pagoda-title"
  >
    <div class={panelClass} data-chapter-card>
      <h2 id="pagoda-title" class={titleClass}>{project.name}</h2>
      <p class={bodyClass}>{project.description}</p>
      <a
        href={project.url}
        class="bubble-button mt-3 inline-block rounded-full bg-forest px-5 py-2 text-sm font-bold text-cream md:mt-4"
        rel="noopener"
      >
        Ver {project.name}
      </a>
    </div>
  </section>

  <!-- The last stretch keeps its scroll height with no card, so the video
       ending (lanterns into a warm dusk) plays over the finished tree. -->
  <section
    id="finished"
    data-chapter="finished"
    class={sectionClass}
    style={sectionStyle("finished")}
    aria-hidden="true"
  ></section>
</Layout>


<style is:global>
  /* Cards scroll like a page (S13). Each card is sticky inside its own section
     or career stop: on mobile it rides in with the section's bottom edge and is
     held 0.75rem above the bottom of the viewport; from md it comes in with the
     section top and is held at the vertical centre (`translate` centres the box
     on the line). When its section ends, the page carries it away and the next
     card comes in behind it. Nothing fades or hides, so it works without
     JavaScript and with reduced motion alike. */
  [data-chapter-card] {
    position: sticky;
    bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    [data-chapter-card] {
      top: 50svh;
      bottom: auto;
      translate: 0 -50%;
    }
  }

  /* Contact bar: top right corner, above the sections (z-index 10) and the
     video, inset like the sections' side padding. */
  [data-contact-bar] {
    position: fixed;
    top: 0.75rem;
    right: 1rem;
    z-index: 20;
  }

  @media (min-width: 768px) {
    [data-contact-bar] {
      top: 1.25rem;
      right: 4rem;
    }
  }

  /* Layout's <main> is overflow-hidden, which makes it the sticky scroll
     container and freezes the cards; clip keeps the clipping without that. */
  main {
    overflow: clip;
  }

  /* Bubble surface: a solid palette-cream body, a soft sand shade toward the
     bottom right, a bright rim, an inner top highlight, a soft inner shade at
     the bottom and layered drop shadows, so each card reads as a rounded
     object floating over the scene. */
  .bubble-card {
    border-radius: 28px;
    border: 1px solid rgb(255 255 255 / 0.65);
    background-image: linear-gradient(165deg, transparent 45%, rgb(230 225 214 / 0.55));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 0 -14px 28px -18px rgb(18 58 47 / 0.22),
      0 1px 2px rgb(11 38 32 / 0.12),
      0 12px 28px -10px rgb(11 38 32 / 0.3),
      0 36px 70px -28px rgb(11 38 32 / 0.45);
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 280ms ease;
  }

  @media (hover: hover) and (min-width: 768px) {
    .bubble-card:hover {
      transform: translateY(-4px) scale(1.005);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.95),
        inset 0 -14px 28px -18px rgb(18 58 47 / 0.22),
        0 2px 4px rgb(11 38 32 / 0.12),
        0 20px 36px -12px rgb(11 38 32 / 0.35),
        0 48px 90px -30px rgb(11 38 32 / 0.5);
    }
  }

  .bubble-chip {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 -2px 4px rgb(18 58 47 / 0.08),
      0 2px 6px -2px rgb(11 38 32 / 0.18);
  }

  .bubble-button {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      inset 0 -3px 6px rgb(0 0 0 / 0.2),
      0 8px 18px -6px rgb(11 38 32 / 0.5);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .bubble-button:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble-card,
    .bubble-button {
      transition: none;
    }
    .bubble-card:hover,
    .bubble-button:hover {
      transform: none;
    }
  }
</style>
