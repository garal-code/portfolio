---
import Layout from "../layouts/Layout.astro";
import BonsaiVideo from "../components/bonsai/BonsaiVideo.astro";
import { careerOrder } from "../lib/bonsai/career.ts";
import { CHAPTERS, type ChapterId } from "../lib/bonsai/chapters.ts";
import {
  education,
  interests,
  jobs,
  personalInfo,
  project,
  skills,
} from "../data/resume.ts";

// One section per chapter, in the approved S3 order. Section height follows the
// chapter scrollWeight; the scroll-scrubbed video (S9) is fixed behind.
const weight = (id: ChapterId) =>
  CHAPTERS.find((chapter) => chapter.id === id)!.scrollWeight;
const sectionStyle = (id: ChapterId) =>
  `--chapter-height: calc(${weight(id)} * 100svh);`;

const years = (start: string, end?: string) => `${start}–${end ?? "hoy"}`;
// resume.ts lists jobs newest first; the branches grow oldest first, the same
// order the generator uses.
const careerJobs = careerOrder(jobs);
const careerSlice = weight("branches") / careerJobs.length;

// Below md the card is compact and sits at the bottom of the viewport (the copy
// safe zone, ~45%), so the video stays visible above it. A max-height with
// internal scroll keeps it from growing over the scene when its content grows
// later (S7). From md up it is the 40% left column, vertically centred.
//
// Each card lives in a `data-card-pin` wrapper. With JavaScript the wrapper is
// fixed to the viewport, so a card never moves while you scroll, and only the
// card of the section (or career stop) holding the viewport centre is visible
// (`data-active`, see the style and script below). Without JavaScript the wrapper
// has no box and the card stays in its section's flow, as before.
//
// The sections keep their scroll heights: the background player measures them.
// On mobile the first one is one screen taller (`firstExtra`), as it has been
// since the cards were pinned to the bottom edge; changing it would move the
// video anchors.
const sectionClass =
  "relative z-10 flex min-h-[var(--chapter-height)] items-end px-4 py-3 md:items-center md:px-16 md:py-10";
const firstExtra = "max-md:min-h-[calc(var(--chapter-height)+100svh)]";
// The cards float over the video as soft bubbles (`.bubble-card` below): large
// radius, a light rim, an inner highlight and layered shadows. The cream fill
// stays opaque enough for AA text over any frame.
const panelClass =
  "bubble-card max-h-[42svh] w-full overflow-y-auto bg-cream/95 p-4 md:max-h-[88svh] md:max-w-[40%] md:bg-cream/92 md:p-6";
const eyebrowClass =
  "text-xs font-bold uppercase tracking-[0.2em] text-sage-dark";
const titleClass =
  "mt-2 font-display text-2xl font-extrabold tracking-tight text-forest md:mt-3 md:text-4xl";
const bodyClass =
  "mt-2 text-sm leading-relaxed text-body md:mt-3 md:text-base";
const chipListClass =
  "mt-3 flex flex-wrap gap-1.5 text-xs text-forest md:mt-4 md:gap-2 md:text-sm";
const chipClass = "bubble-chip rounded-full bg-sand px-2.5 py-0.5 md:px-3 md:py-1";
---

<Layout
  title={`Bonsai — ${personalInfo.name}`}
  description={personalInfo.summary}
>
  <script is:inline>
    document.documentElement.classList.add("js");
  </script>
  <BonsaiVideo />

  <section
    id="seed"
    data-chapter="seed"
    data-card-zone="seed"
    class={`${sectionClass} ${firstExtra}`}
    style={sectionStyle("seed")}
    aria-labelledby="seed-title"
  >
    <div data-card-pin data-active>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>01 · Semilla</p>
        <h1
          id="seed-title"
          class="mt-2 font-display text-3xl font-extrabold leading-[0.95] tracking-tight text-forest md:mt-3 md:text-5xl"
        >
          {personalInfo.name}
        </h1>
        <p class={bodyClass}>{personalInfo.bio}</p>
        <ul class={chipListClass}>
          {
            interests.map((interest) => (
              <li class={chipClass}>
                {interest.title} · {interest.note}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    id="sprout"
    data-chapter="sprout"
    data-card-zone="sprout"
    class={sectionClass}
    style={sectionStyle("sprout")}
    aria-labelledby="sprout-title"
  >
    <div data-card-pin>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>02 · Brote</p>
        <h2 id="sprout-title" class={titleClass}>Dónde empezó</h2>
        <ul class="mt-3 space-y-2 text-sm text-body md:mt-4 md:space-y-3 md:text-base">
          {
            education.map((item) => (
              <li>
                <p class="font-semibold text-ink">{item.degree}</p>
                <p class="text-sm text-meta">
                  {item.institution} · {years(item.startYear, item.endYear)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    id="trunk"
    data-chapter="trunk"
    data-card-zone="trunk"
    class={sectionClass}
    style={sectionStyle("trunk")}
    aria-labelledby="trunk-title"
  >
    <div data-card-pin>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>03 · Tronco</p>
        <h2 id="trunk-title" class={titleClass}>Los fundamentos</h2>
        <p class={bodyClass}>{personalInfo.summary}</p>
        <ul class={chipListClass}>
          {skills.map((skill) => <li class={chipClass}>{skill}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section
    id="branches"
    data-chapter="branches"
    class="relative z-10 min-h-[var(--chapter-height)] px-4 md:px-16"
    style={sectionStyle("branches")}
    aria-labelledby="branches-title"
  >
    <ol class="m-0 list-none p-0">
      {
        careerJobs.map((job, index) => (
          <li
            data-branch-stop={index}
            data-card-zone={`branches-${index}`}
            class="flex items-end py-3 md:items-center md:py-10"
            style={`min-height: calc(${careerSlice} * 100svh);`}
          >
            <div data-card-pin>
              <article class={panelClass} data-chapter-card>
                {index === 0 && (
                  <>
                    <p class={eyebrowClass}>04 · Ramas</p>
                    <h2 id="branches-title" class={titleClass}>La carrera</h2>
                  </>
                )}
                <p class="mt-3 font-display text-xl font-bold text-forest md:mt-4 md:text-2xl">
                  {job.company}
                </p>
                <p class="text-sm text-meta">
                  {job.role} · {years(job.startDate, job.endDate)}
                </p>
                <p class={bodyClass}>{job.summary}</p>
              </article>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    id="pruning"
    data-chapter="pruning"
    data-card-zone="pruning"
    class={sectionClass}
    style={sectionStyle("pruning")}
    aria-labelledby="pruning-title"
  >
    <div data-card-pin>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>05 · Poda</p>
        <h2 id="pruning-title" class={titleClass}>Cómo trabaja</h2>
        <ul class="mt-3 space-y-2 text-sm text-body md:mt-4 md:text-base">
          {personalInfo.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section
    id="pagoda"
    data-chapter="pagoda"
    data-card-zone="pagoda"
    class={sectionClass}
    style={sectionStyle("pagoda")}
    aria-labelledby="pagoda-title"
  >
    <div data-card-pin>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>06 · Pagoda</p>
        <h2 id="pagoda-title" class={titleClass}>{project.name}</h2>
        <p class={bodyClass}>{project.description}</p>
        <a
          href={project.url}
          class="bubble-button mt-3 inline-block rounded-full bg-forest px-5 py-2 text-sm font-bold text-cream md:mt-4"
          rel="noopener"
        >
          Ver {project.name}
        </a>
      </div>
    </div>
  </section>

  <section
    id="finished"
    data-chapter="finished"
    data-card-zone="finished"
    class={sectionClass}
    style={sectionStyle("finished")}
    aria-labelledby="finished-title"
  >
    <div data-card-pin>
      <div class={panelClass} data-chapter-card>
        <p class={eyebrowClass}>07 · Bonsai terminado</p>
        <h2 id="finished-title" class={titleClass}>Hablemos</h2>
        <ul class="mt-3 space-y-2 text-sm text-forest underline md:mt-4 md:text-base">
          <li><a href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a></li>
          <li><a href={personalInfo.links.github} rel="noopener">GitHub</a></li>
          <li><a href={personalInfo.links.linkedin} rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { activeCardId } from "../lib/bonsai/active-card.ts";

  // One card is visible at a time: the one whose section (or career stop) holds
  // the vertical centre of the viewport. The choice is recomputed from the
  // section rectangles on every scroll frame, so it is the same going down or up.
  const zones = Array.from(document.querySelectorAll<HTMLElement>("[data-card-zone]")).map(
    (element) => ({
      id: element.dataset.cardZone ?? "",
      element,
      pin: element.querySelector<HTMLElement>("[data-card-pin]"),
    }),
  );
  let current: string | undefined;
  let frame = 0;

  const update = () => {
    const id = activeCardId(
      zones.map(({ id, element }) => {
        const { top, bottom } = element.getBoundingClientRect();
        return { id, top, bottom };
      }),
      window.innerHeight,
    );
    if (id === current) return;
    current = id;
    for (const zone of zones) {
      const active = zone.id === id;
      zone.pin?.toggleAttribute("data-active", active);
      zone.pin?.toggleAttribute("inert", !active);
      if (active) zone.pin?.removeAttribute("aria-hidden");
      else zone.pin?.setAttribute("aria-hidden", "true");
    }
  };
  const schedule = () => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      update();
    });
  };

  try {
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    window.addEventListener("load", schedule);
    void document.fonts?.ready.then(schedule);
    if (import.meta.hot) {
      import.meta.hot.dispose(() => {
        window.removeEventListener("scroll", schedule);
        window.removeEventListener("resize", schedule);
        window.removeEventListener("load", schedule);
        cancelAnimationFrame(frame);
      });
    }
  } catch {
    // Show every card in the document flow instead of hiding the unmeasured ones.
    document.documentElement.classList.remove("js");
  }
</script>

<style is:global>
  /* Pinned cards. Without JavaScript the wrapper has no box and each card stays
     in its section's flow. With it (`html.js`, set before the sections render)
     the wrapper is a full-height layer fixed to the viewport: the card sits at
     the bottom on mobile and is centred in the left column from md, and it never
     moves while you scroll. The script marks one wrapper `data-active`; the
     others fade out and are hidden, so no card is ever cut off or half visible. */
  [data-card-pin] {
    display: contents;
  }

  html.js [data-card-pin] {
    position: fixed;
    inset-inline: 0;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem 1rem;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    html.js [data-card-pin] {
      align-items: center;
      padding: 2.5rem 4rem;
    }
  }

  /* Crossfade: 350ms, with a slight 8px rise. The card is hidden (no focus, no
     pointer) once its fade-out ends and visible again at the start of its fade-in.
     `translate` composes with the hover `transform`, whose transition is repeated
     here because this rule is more specific than `.bubble-card`. */
  html.js [data-chapter-card] {
    pointer-events: auto;
    opacity: 0;
    translate: 0 8px;
    visibility: hidden;
    transition:
      opacity 350ms ease,
      translate 350ms ease,
      visibility 0s linear 350ms,
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 280ms ease;
  }

  html.js [data-card-pin][data-active] [data-chapter-card] {
    opacity: 1;
    translate: none;
    visibility: visible;
    transition:
      opacity 350ms ease,
      translate 350ms ease,
      visibility 0s,
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 280ms ease;
  }

  /* Bubble surface: a translucent cream body with a specular sheen near the top
     left, a bright rim, a soft inner shade at the bottom and layered drop
     shadows, so each card reads as a rounded object floating over the scene. */
  .bubble-card {
    border-radius: 28px;
    border: 1px solid rgb(255 255 255 / 0.65);
    background-image:
      radial-gradient(120% 70% at 12% 0%, rgb(255 255 255 / 0.6), transparent 55%),
      linear-gradient(165deg, rgb(255 255 255 / 0.2), rgb(230 225 214 / 0.25));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 0 -14px 28px -18px rgb(18 58 47 / 0.22),
      0 1px 2px rgb(11 38 32 / 0.12),
      0 12px 28px -10px rgb(11 38 32 / 0.3),
      0 36px 70px -28px rgb(11 38 32 / 0.45);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 280ms ease;
  }

  @media (hover: hover) and (min-width: 768px) {
    .bubble-card:hover {
      transform: translateY(-4px) scale(1.005);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.95),
        inset 0 -14px 28px -18px rgb(18 58 47 / 0.22),
        0 2px 4px rgb(11 38 32 / 0.12),
        0 20px 36px -12px rgb(11 38 32 / 0.35),
        0 48px 90px -30px rgb(11 38 32 / 0.5);
    }
  }

  .bubble-chip {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 -2px 4px rgb(18 58 47 / 0.08),
      0 2px 6px -2px rgb(11 38 32 / 0.18);
  }

  .bubble-button {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      inset 0 -3px 6px rgb(0 0 0 / 0.2),
      0 8px 18px -6px rgb(11 38 32 / 0.5);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .bubble-button:hover {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble-card,
    .bubble-button {
      transition: none;
    }
    .bubble-card:hover,
    .bubble-button:hover {
      transform: none;
    }
    html.js [data-chapter-card],
    html.js [data-card-pin][data-active] [data-chapter-card] {
      transition: none;
      translate: none;
    }
  }
</style>
