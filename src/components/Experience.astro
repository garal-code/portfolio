---
import { jobs, isCurrentJob } from "../data/resume.ts";

function formatDate(dateStr: string): string {
  const [year, month = "01"] = dateStr.split("-");

  if (!dateStr.includes("-")) {
    return year;
  }

  const date = new Date(Number(year), Number(month) - 1);
  return date.toLocaleDateString("es-ES", { month: "short", year: "numeric" });
}
---

<section id="experience" aria-label="Experiencia profesional" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-12" data-animate>
      <span class="eyebrow">Trayectoria</span>
      <h2 class="font-display mt-3 text-3xl font-bold text-text sm:text-4xl">Experiencia</h2>
    </div>

    <ol class="relative space-y-10 border-l border-accent/20 pl-8">
      {
        jobs.map((job) => (
          <li class="relative" data-animate>
            <span
              class="absolute -left-[2.7rem] top-6 flex h-5 w-5 items-center justify-center rounded-full border-2 border-accent bg-bg"
              aria-hidden="true"
            >
              <span class="h-2 w-2 rounded-full bg-plum" />
            </span>

            <article class="section-panel rounded-[1.9rem] p-6 transition-colors hover:border-accent/40 sm:p-8">
              <header class="mb-3">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                  <h3 class="font-display text-2xl font-bold text-text">{job.role}</h3>
                  <time
                    class="shrink-0 text-xs font-semibold uppercase tracking-[0.16em] text-text-muted"
                    datetime={job.startDate}
                  >
                    {formatDate(job.startDate)} —{" "}
                    {isCurrentJob(job) ? (
                      <span class="font-semibold text-accent">Actualidad</span>
                    ) : (
                      <span>{formatDate(job.endDate!)}</span>
                    )}
                  </time>
                </div>
                <p class="mt-1 text-sm font-semibold uppercase tracking-[0.16em] text-plum">{job.company}</p>
              </header>

              <p class="font-body mb-5 text-base leading-8 text-umber">
                {job.description}
              </p>

              <ul class="flex flex-wrap gap-2" aria-label="Tecnologías">
                {job.technologies.map((tech) => (
                  <li>
                    <span class="inline-block rounded-full border border-border bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-umber">
                      {tech}
                    </span>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
