---
import { personalInfo } from "../data/resume.ts";
---

<footer aria-label="Contacto" class="px-1 pb-16 md:px-16">
  <div
    class="flex flex-col items-start gap-6 rounded-[20px] bg-gold p-4 sm:flex-row sm:items-center sm:justify-between"
    data-animate
  >
    <p
      class="font-display text-[25px] font-extrabold tracking-[-0.02em] text-ink"
    >
      ¿Hablamos de software, mercados o IA?
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href={personalInfo.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border-[1.5px] border-forest px-5 py-[11px] text-sm font-bold text-ink hover:opacity-85"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${personalInfo.email}`}
        class="rounded-xl border-[1.5px] border-forest px-5 py-[11px] text-sm font-bold text-ink hover:opacity-85"
      >
        Email
      </a>
      <a
        href={personalInfo.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border-[1.5px] border-forest px-5 py-[11px] text-sm font-bold text-ink hover:opacity-85"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
