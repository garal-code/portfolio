---
import { getSkillsByCategory, getCategoryLabel } from "../data/resume.ts";
import type { SkillCategory } from "../data/resume.ts";

const grouped = getSkillsByCategory();
const categories: SkillCategory[] = ["backend", "frontend", "devops", "tools"];

// Category icons (inline SVG paths)
const categoryIcons: Record<SkillCategory, string> = {
  backend: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10",
  frontend: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z",
  devops: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
  tools: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
};
---

<section
  id="skills"
  aria-label="Habilidades técnicas"
  class="py-24 px-6"
>
  <div class="max-w-4xl mx-auto">
    <!-- Heading -->
    <div class="mb-12" data-animate>
      <h2 class="text-3xl sm:text-4xl font-bold text-text mb-2">Habilidades</h2>
      <div class="h-0.5 w-16 bg-accent rounded-full"></div>
    </div>

    <!-- Categories grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        categories.map((category) => {
          const categorySkills = grouped[category];
          if (!categorySkills || categorySkills.length === 0) return null;
          return (
            <div
              class="rounded-xl border border-border bg-surface p-6"
              data-animate
            >
              <!-- Category header -->
              <div class="flex items-center gap-3 mb-4">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-accent"
                    aria-hidden="true"
                  >
                    <path d={categoryIcons[category]} />
                  </svg>
                </div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-text-muted">
                  {getCategoryLabel(category)}
                </h3>
              </div>

              <!-- Skill badges -->
              <ul class="flex flex-wrap gap-2" aria-label={`Habilidades de ${getCategoryLabel(category)}`}>
                {categorySkills.map((skill) => (
                  <li>
                    <span class="inline-block rounded-md border border-border bg-bg px-3 py-1 text-xs font-medium text-text transition-colors hover:border-accent/50 hover:text-accent">
                      {skill.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
