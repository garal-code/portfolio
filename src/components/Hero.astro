---
import { personalInfo, interests, project } from "../data/resume.ts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section
  id="hero"
  aria-label="Presentación"
  class="bg-forest px-6 pt-8 text-cream md:px-16"
>
  <nav
    aria-label="Navegación principal"
    class="flex flex-wrap items-center justify-end gap-7"
  >
    <a
      href={personalInfo.links.github}
      target="_blank"
      rel="noopener noreferrer"
      class="font-sans text-sm font-semibold text-gold hover:opacity-85"
    >
      Github
    </a>
    <a
      href={personalInfo.links.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="font-sans text-sm font-semibold text-gold hover:opacity-85"
    >
      LinkedIn
    </a>
  </nav>

  <div
    class="grid gap-8 pt-12 pb-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-end lg:gap-14 lg:pt-[72px] lg:pb-12"
    data-animate
  >
    <div class="flex flex-col gap-5">
      <h1
        class="max-w-[782px] font-display text-[clamp(48px,9vw,104px)] font-extrabold leading-[0.9] tracking-[-0.04em]"
      >
        {personalInfo.name}
      </h1>
      <p
        class="font-display text-xl font-bold leading-none tracking-[-0.02em] text-gold"
      >
        {personalInfo.bio}.
      </p>
    </div>

    <div id="intereses" class="flex flex-col gap-3.5">
      <span
        class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-sage"
      >
        Lo que sigo de cerca
      </span>
      <ul>
        {
          interests.map((interest) => (
            <li class="flex items-baseline justify-between gap-4 border-y border-rule-dark py-3.5">
              <span class="font-display text-2xl font-bold">
                {interest.title}
              </span>
              <span class="font-sans text-sm text-mint-muted">
                {interest.note}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    id="tu-cartera"
    class="grid overflow-hidden rounded-t-[20px] bg-cream lg:grid-cols-[minmax(0,1fr)_300px]"
    data-animate
  >
    <img
      src={`${base}${project.image}`}
      alt="Captura de la landing de Tu Cartera"
      loading="lazy"
      class="h-[280px] w-full bg-forest-deep object-cover lg:h-[440px]"
    />

    <div class="flex flex-col justify-between gap-6 p-8">
      <div class="flex flex-col gap-3">
        <span
          class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-sage-dark"
        >
          Proyecto personal
        </span>
        <h2
          class="font-display text-4xl font-extrabold leading-none tracking-[-0.02em] text-ink"
        >
          {project.name}
        </h2>
        <p class="text-base leading-[1.55] text-body">
          {project.description}
        </p>
      </div>

      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-xl bg-forest px-5 py-3.5 text-[15px] font-bold text-cream hover:opacity-85"
      >
        Ver la app →
      </a>
    </div>
  </div>
</section>
