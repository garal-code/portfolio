---
import { education, courses, certifications } from "../data/resume.ts";
---

<section id="background" aria-label="Formación y certificaciones" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-12" data-animate>
      <span class="eyebrow">Base técnica</span>
      <h2 class="font-display mt-3 text-3xl font-bold text-text sm:text-4xl">Formación</h2>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <article class="section-panel rounded-[1.75rem] p-6 sm:p-8" data-animate>
        <h3 class="font-display text-2xl font-bold text-text">Trayectoria académica</h3>

        <div class="mt-6 space-y-6">
          {education.map((item) => (
            <div class="border-l-2 border-accent/35 pl-5">
              <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <p class="font-body text-lg font-semibold text-text">{item.degree}</p>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
                  {item.startYear} — {item.endYear}
                </p>
              </div>
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">{item.institution}</p>

              {item.details && item.details.length > 0 && (
                <ul class="mt-3 space-y-2">
                  {item.details.map((detail) => (
                    <li class="font-body text-sm leading-7 text-umber">{detail}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </article>

      <div class="space-y-6">
        <article class="section-panel rounded-[1.75rem] p-6" data-animate>
          <h3 class="font-display text-2xl font-bold text-text">Cursos destacados</h3>

          <ul class="mt-5 space-y-4">
            {courses.map((course) => (
              <li class="rounded-2xl border border-border bg-white/75 px-4 py-4">
                <p class="font-body text-base font-semibold text-text">{course.title}</p>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
                  {[course.provider, course.year].filter(Boolean).join(" · ")}
                </p>
              </li>
            ))}
          </ul>
        </article>

        <article class="section-panel rounded-[1.75rem] p-6" data-animate>
          <h3 class="font-display text-2xl font-bold text-text">Idiomas y certificaciones</h3>

          <ul class="mt-5 space-y-4">
            {certifications.map((item) => (
              <li class="rounded-2xl border border-border bg-white/75 px-4 py-4">
                <p class="font-body text-base font-semibold text-text">{item.title}</p>
                <p class="mt-1 text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
                  {[item.issuer, item.note].filter(Boolean).join(" · ")}
                </p>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>
